{#- Meal income: for each meal plan and price tier, how many campers and what
    they were charged for meals (camper.pricing.meals, the camper's actual
    Meals line). Campers whose meals cost nothing (free-meal registration
    types, instructor meal rate, food trade) are counted on their plan's Free
    row. The first-time camper referrer promo code's meal discount is its own
    row, then the grand total. A registrar's override shows in Total as the
    amount charged, so Total can differ from Qty x Unit Price; an override that
    charges a camper with no meal plan lands on Other meal charges. Prices and
    tiers follow camperPricingLogic.ts: 12 and up pay the adult price, 0-11 the
    youth (Child) price. -#}
{%- set plans = [
    ('All Meals', 'full'),
    ('All Meals - 1st half', 'half'),
    ('All Meals - 2nd half', 'half'),
    ('Just Dinners', 'dinners'),
] -%}
{%- set child_ages = ['0-4 years old', '5-11 years old'] -%}
{%- set rows = [] -%}
{%- for camper in campers -%}
    {%- set charged = camper.pricing.meals or 0 -%}
    {%- do rows.append({
        'plan': (camper.attributes.meals or {}).meal_plan,
        'tier': 'Free' if not charged else ('Child' if camper.attributes.age in child_ages else 'Adult'),
        'charged': charged,
    }) -%}
{%- endfor -%}

{#- The referrer code is this event's only registration-scoped promo code, and
    it comes off meals only. A camper-scoped code (first-time camper, off
    tuition) puts a promo line on each camper, so a registration whose campers
    have none used the referrer code. Templates can't see which code was used,
    so a registration-scoped code an admin adds in Camphoric would land on
    this row too, and come off the Grand Total. -#}
{%- set discount = namespace(count=0, total=0) -%}
{%- for registration in registrations -%}
    {%- set promo = registration.pricing.promo or 0 -%}
    {%- set camper_scoped = namespace(found=false) -%}
    {%- for camper in registration.campers if 'promo' in camper.pricing -%}
        {%- set camper_scoped.found = true -%}
    {%- endfor -%}
    {%- if promo and not camper_scoped.found -%}
        {%- set discount.count = discount.count + 1 -%}
        {%- set discount.total = discount.total + promo -%}
    {%- endif -%}
{%- endfor -%}

{%- set plan_names = plans | map('first') | list -%}
{%- set paid = rows | selectattr('plan', 'in', plan_names) | list -%}
{#- A registrar's override can charge a camper with no meal plan for meals -#}
{%- set other = rows | rejectattr('plan', 'in', plan_names) | selectattr('charged') | list -%}
{%- set counted = paid + other -%}
Meal Plan,Tier,Qty,Unit Price,Total
{%- for plan, size in plans -%}
{%- for tier, price in [
    ('Adult', event.pricing['meals_adult_' ~ size]),
    ('Child', event.pricing['meals_youth_' ~ size]),
    ('Free', 0),
] -%}
{%- set matched = paid | selectattr('plan', '==', plan) | selectattr('tier', '==', tier) | list %}
{{ plan }},{{ tier }},{{ matched | length }},{{ price }},{{ matched | sum(attribute='charged') }}
{%- endfor -%}
{%- endfor %}
Other meal charges,,{{ other | length }},,{{ other | sum(attribute='charged') }}
Referrer promo meal discount (registration-scoped codes),,{{ discount.count }},,{{ discount.total }}
Grand Total,,{{ counted | length }},,{{ (counted | sum(attribute='charged')) + discount.total }}
